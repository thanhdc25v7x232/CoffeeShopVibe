# Caddyfile dùng để demo HTTPS/HTTP2 cục bộ.
#
# Chạy song song 2 tiến trình:
#   1) php -S localhost:8000 -t public        (server PHP built-in, HTTP thuần)
#   2) caddy run                              (đọc file này, đứng trước làm reverse proxy)
#
# Sau đó truy cập https://localhost:8443 — Caddy tự cấp chứng chỉ TLS nội bộ (tls internal)
# và phục vụ qua HTTP/2, che luôn cổng 8000 phía sau.
#
# Lần đầu chạy, Caddy sẽ hỏi cài đặt root CA cục bộ vào trình duyệt/hệ điều hành để
# https://localhost:8443 không bị cảnh báo "not secure".

localhost:8443 {
	tls internal

	encode gzip zstd

	# Cache dài hạn cho ảnh/css/js tĩnh trong public/
	@static path /css/* /img/* /uploads/* /js/*
	header @static Cache-Control "public, max-age=604800, immutable"

	# Chat WebSocket: proxy /ws sang daemon websocket_server.php (cổng 8081).
	# Bắt buộc đứng TRƯỚC reverse_proxy chung bên dưới. Caddy tự xử lý WebSocket upgrade.
	reverse_proxy /ws localhost:8081

	reverse_proxy localhost:8000
}

# Cong HTTP thuan (khong TLS), cung cau hinh voi khoi tren, danh rieng cho
# `cloudflared tunnel --url http://localhost:8444` khi dung Cach 3 o README.
# Ly do co khoi rieng nay: tren Windows, `cloudflared --no-tls-verify` doi khi
# khong bo qua duoc xac thuc chung chi tu ky cua Caddy (cloudflared tu bao
# "does not support loading the system root certificate pool on Windows"),
# khien tunnel tra ve 200 nhung body rong. Tro thang vao cong HTTP nay tranh
# hoan toan van de TLS do, trong khi van giu duoc route /ws proxy real-time.
:8444 {
	encode gzip zstd

	@static path /css/* /img/* /uploads/* /js/*
	header @static Cache-Control "public, max-age=604800, immutable"

	reverse_proxy /ws localhost:8081

	reverse_proxy localhost:8000
}
